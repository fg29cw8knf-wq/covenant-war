; The native video player (NativeVideoPlayer): Gary's 4K films through the
; iPhone's and the Mac's own player (AVPlayer). Source and notes in src/;
; the libraries in bin/ are built by .github/workflows/native-video.yml and
; fetched by the iPhone and Mac app workflows before they export. On every
; other platform (the phone link, Linux, the editor here) there's no library,
; the engine says so once at start-up, and the game plays its Theora copy.

[configuration]

entry_symbol = "native_video_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.debug = "res://addons/native_video/bin/libnativevideo.macos.template_release.framework"
macos.release = "res://addons/native_video/bin/libnativevideo.macos.template_release.framework"
ios.debug = "res://addons/native_video/bin/libnativevideo.ios.template_release.xcframework"
ios.release = "res://addons/native_video/bin/libnativevideo.ios.template_release.xcframework"
