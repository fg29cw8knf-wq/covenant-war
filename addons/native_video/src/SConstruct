#!/usr/bin/env python
# Builds the native video player extension (see native_video_player.h) with
# godot-cpp, for the two platforms that have a native player:
#
#   scons platform=macos arch=universal target=template_release
#   scons platform=ios   arch=arm64     target=template_release ios_min_version=16.0
#
# godot-cpp (master: versioned on its own since v10, it targets the engine
# version given as api_version, 4.7 here) is expected next to this file,
# cloned by the workflow: see .github/workflows/native-video.yml, which also
# wraps the iOS static library into the .xcframework the .gdextension names.
# build_profile=build_profile.json on the command line keeps the generated
# bindings to the few engine classes the player uses. Run on a Mac with Xcode.
import os

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})

if env["platform"] not in ("macos", "ios"):
    print("The native video player is built for macOS and iOS only (platform=%s)." % env["platform"])
    Exit(1)

env.Append(CPPPATH=["."])

# The Objective-C++ side, with ARC. The frameworks it uses are linked below
# on the Mac; on the iPhone the static library is linked into Godot's own app,
# which links AVFoundation, CoreMedia, QuartzCore and UIKit already.
objc_env = env.Clone()
objc_env.Append(CCFLAGS=["-fobjc-arc"])

sources = [
    env.Object("register_types.cpp"),
    objc_env.Object("native_video_player.mm"),
]

if env["platform"] == "macos":
    env.Append(LINKFLAGS=["-framework", "Foundation", "-framework", "AppKit", "-framework", "AVFoundation", "-framework", "CoreMedia", "-framework", "QuartzCore"])
    name = "libnativevideo.{}.{}".format(env["platform"], env["target"])
    library = env.SharedLibrary("bin/{}.framework/{}".format(name, name), source=sources)
else:
    # a static library: Godot's iOS export links it into the app and registers
    # its entry symbol itself (static .xcframework)
    suffix = ".simulator" if env["ios_simulator"] else ""
    library = env.StaticLibrary("bin/libnativevideo.{}.{}{}.a".format(env["platform"], env["target"], suffix), source=sources)

env.NoCache(library)
Default(library)
